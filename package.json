{
  "name": "taller-gateway",
  "version": "1.0.0",
  "description": "Gateway de microservicios con API Gateway",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "deploy:dev": "serverless deploy --stage develop",
    "deploy:prod": "serverless deploy --stage prod",
    "remove:dev": "serverless remove --stage develop",
    "remove:prod": "serverless remove --stage prod"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.500.0",
    "@aws-sdk/client-lambda": "^3.500.0",
    "@aws-sdk/lib-dynamodb": "^3.500.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.137",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/uuid": "^9.0.8",
    "aws-lambda": "^1.0.6",
    "serverless": "^4.36.1",
    "serverless-localstack": "^1.1.2",
    "typescript": "^5.4.5"
  }
}
